---
import type { GreetingCard } from "../../data/cards";
import {
  formatCardPrice,
  getCardPhysicalSpecLine,
  getSnipcartCardDescription,
  getSnipcartCardName,
} from "../../data/cardHelpers";
import {
  getAllowOutOfStockPurchases,
  getEffectiveInventory,
  shouldRenderSnipcartPurchaseControl,
} from "../../data/productRules";

const { card } = Astro.props as { card: GreetingCard };
const snipcartEnabled = Boolean(import.meta.env.PUBLIC_SNIPCART_API_KEY);
const price = formatCardPrice(card.price);
const cardUrl = new URL(`/cards/${card.slug}/`, "https://tommyday.com").href;
const effectiveInventory = getEffectiveInventory(card);
const rendersSnipcartControl = shouldRenderSnipcartPurchaseControl(card);
const physicalSpecLine = getCardPhysicalSpecLine(card);
---

<aside class="card-purchase-panel" aria-label={`${card.title} purchase options`}>
  <p class="card-purchase-panel__eyebrow">{physicalSpecLine}</p>
  <h2>{price} per card.</h2>
  <p>No minimum. Add one card or build a custom five-card stack.</p>

  <div class="card-purchase-panel__actions">
    {rendersSnipcartControl && snipcartEnabled ? (
      <button
        class="card-primary-button snipcart-add-item"
        data-item-id={card.id}
        data-item-price={card.price}
        data-item-url={cardUrl}
        data-item-description={getSnipcartCardDescription(card)}
        data-item-image={card.frontImage}
        data-item-name={getSnipcartCardName(card)}
        data-item-max-quantity={effectiveInventory}
        data-initial-inventory={card.initialInventory}
        data-allow-out-of-stock-purchases={String(getAllowOutOfStockPurchases(card))}
      >
        Add card &mdash; {price}
      </button>
    ) : rendersSnipcartControl ? (
      <div class="card-purchase-panel__disabled">
        Cart unavailable until Snipcart is configured.
      </div>
    ) : (
      <div class="card-purchase-panel__disabled">Not on sale yet.</div>
    )}

    <a class="card-primary-button card-primary-button--quiet" href={`/cards/build-a-pack/?start=${card.slug}`}>
      Build a 5-card stack
    </a>
  </div>

</aside>
