---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteShell from "../components/SiteShell.astro";
import ArtCard from "../components/ArtCard.astro";
import { featuredArtworks } from "../data/artworks";

const featured = featuredArtworks.slice(0, 9);
---
<BaseLayout
  title="Tommy Day Art - Analog Collage, Prints, Cards, and Paper Goods"
  description="Analog collage, prints, cards, and strange paper goods by Tommy Day."
  canonicalUrl="/"
>
  <SiteShell>
    <section class="home-brand-hero">
      <div class="home-brand-hero__top">
        <picture>
          <source media="(min-width: 720px)" srcset="/images/tommy-day-art.png" />
          <img
            src="/images/tommy-day-art-small.png"
            alt="Tommy Day Art"
            class="home-brand-hero__logo"
            loading="eager"
          />
        </picture>
      </div>

      <div class="home-brand-hero__copy">
        <h1 class="home-brand-hero__line">Hand-Cut Analog Collage</h1>
        <p class="home-brand-hero__text">
          I'm Tommy, a web developer by day and collage goblin by night. I cut and paste by the glow of an old CRT to create analog collages and strange paper goods.
        </p>
      </div>

      <div class="home-brand-hero__actions">
        <a href="/prints/" class="hero-link hero-link--primary">Shop Prints</a>
        <a href="/cards/build-a-pack/" class="hero-link">Build a Card Pack</a>
        <a href="/originals/" class="hero-link">Browse Originals</a>
      </div>
    </section>

    <section class="home-storefront" aria-labelledby="home-storefront-heading">
      <div class="home-storefront__header">
        <p class="section-eyebrow">Shop</p>
        <h2 id="home-storefront-heading">Originals, prints, and cards</h2>
        <p>Three ways to buy the work, depending on how much wall, mailbox, or danger you are inviting into your life.</p>
      </div>

      <div class="home-storefront__grid">
        <article class="home-storefront-card paper-card">
          <a class="home-storefront-card__image-link" href="/originals/" aria-label="Browse originals">
            <img src="/art/collage/ww3-grid.jpg" alt="WW3 analog collage" loading="lazy" />
          </a>
          <div class="home-storefront-card__body">
            <h3>Originals</h3>
            <p>One-of-one hand-cut analog collages. Once they're gone, they're gone.</p>
            <a href="/originals/" class="hero-link">Browse Originals</a>
          </div>
        </article>

        <article class="home-storefront-card paper-card">
          <a class="home-storefront-card__image-link" href="/prints/" aria-label="Shop prints">
            <img src="/art/collage/golden-age-gal-grid.jpg" alt="Golden Age Gal analog collage" loading="lazy" />
          </a>
          <div class="home-storefront-card__body">
            <h3>Prints</h3>
            <p>Signed small-batch reproductions of selected collages.</p>
            <a href="/prints/" class="hero-link">Shop Prints</a>
          </div>
        </article>

        <article class="home-storefront-card paper-card home-storefront-card--cards">
          <a class="home-storefront-card__image-link" href="/cards/build-a-pack/" aria-label="Build a greeting card pack">
            <img src="/art/collage/dogbday-grid.jpg" alt="Happy Birthday Dog greeting card artwork" loading="lazy" />
          </a>
          <div class="home-storefront-card__body">
            <h3>Greeting Cards</h3>
            <p>Blank-inside collage cards with envelopes included. $7 each, or $6 each when you buy 5 or more.</p>
            <div class="home-storefront-card__actions">
              <a href="/cards/build-a-pack/" class="hero-link">Build a Card Pack</a>
              <a href="/cards/" class="section-link">Browse all cards</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="home-featured" aria-labelledby="home-featured-heading">
      <div class="home-featured__header">
        <p class="section-eyebrow">Featured collage</p>
        <h2 id="home-featured-heading" class="home-featured__title">Recent Cuts</h2>
        <p>
          A few recent collages. Open any piece to see the original artwork and any prints or cards currently available.
        </p>
        <a href="/collage/" class="section-link">View full collage gallery</a>
      </div>

      <div class="home-featured-carousel" aria-label="Featured collage carousel">
        <button
          class="home-featured-carousel__control home-featured-carousel__control--prev"
          type="button"
          aria-label="Scroll featured collage left"
          onclick="this.closest('.home-featured-carousel').querySelector('.home-featured-carousel__track').scrollBy({ left: -420, behavior: 'smooth' })"
        >
          <span aria-hidden="true">←</span>
        </button>
        <div class="home-featured-carousel__track" tabindex="0">
          {featured.map((art) => (
            <div class="home-featured-carousel__slide">
              <ArtCard artwork={art} compact={true} />
            </div>
          ))}
        </div>
        <button
          class="home-featured-carousel__control home-featured-carousel__control--next"
          type="button"
          aria-label="Scroll featured collage right"
          onclick="this.closest('.home-featured-carousel').querySelector('.home-featured-carousel__track').scrollBy({ left: 420, behavior: 'smooth' })"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>

    <section class="home-notes" aria-label="Updates and local shopping">
      <div class="home-newsletter paper-card">
        <p class="section-eyebrow">Mailing list</p>
        <h2>Studio notes, shop drops, and weird paper updates</h2>
        <p>
          Get a note when new originals and small-batch paper goods go live.
        </p>
        <form class="newsletter-form" action="/api/newsletter" method="post" data-newsletter-form>
          <div class="newsletter-form__honeypot" hidden>
            <label for="newsletter-website">Website</label>
            <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <label class="newsletter-form__field" for="newsletter-email">
            <span>Email address</span>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />
          </label>
          <button class="newsletter-form__button" type="submit">Sign up</button>
          <p class="newsletter-form__status" data-newsletter-status aria-live="polite"></p>
        </form>
      </div>

      <a
        class="home-stockist paper-card"
        href="https://www.facebook.com/p/Harlot-Apothecary-61580071557051/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/images/harlot.png" alt="Harlot Apothecary" loading="lazy" />
        <div>
          <p class="section-eyebrow">Shop local</p>
          <h2>Find my work at Harlot Apothecary</h2>
          <p>
            Select Tommy Day Art pieces are available in person at Harlot Apothecary in Indianapolis.
          </p>
        </div>
      </a>
    </section>
  </SiteShell>
</BaseLayout>
